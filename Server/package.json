{
  "name": "ai-menu-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that proxies Gemini calls for the AI Menu iOS app, keeping the Gemini API key server-side.",
  "main": "src/worker.ts",
  "scripts": {
